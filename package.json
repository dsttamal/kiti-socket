{
  "name": "kiti-socket",
  "version": "1.0.0",
  "description": "Socket.IO server with Express.js",
  "main": "main.js",
  "scripts": {
    "start": "node init && node main.js",
    "dev": "node init && nodemon main.js",
    "another": "node another.js",
    "start:all": "node init && concurrently \"node main.js\" \"node another.js\"",
    "dev:all": "node init && concurrently \"nodemon main.js\" \"nodemon another.js\"",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "socket.io",
    "express",
    "websocket"
  ],
  "author": "",
  "license": "ISC"
}
